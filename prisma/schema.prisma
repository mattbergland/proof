generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
enum CaptureType {
  QUICK_QUOTE
  CUSTOMER_WIN
  BEFORE_AFTER
  FEATURE_LOVE
  CASE_STUDY_LEAD
  CUSTOM
}
enum CaptureStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  MULTIPLE_CHOICE
  NUMBER
  PERMISSION
  NAME
  COMPANY
  JOB_TITLE
  EMAIL
}
enum QuestionSource {
  STATIC
  DYNAMIC
}
enum SubmissionStatus {
  COMPLETE
}
enum Permission {
  PUBLIC_FULL
  PUBLIC_COMPANY
  PUBLIC_ANON
  INTERNAL
  ASK_FIRST
}
enum IntegrationType {
  EMAIL
  WEBHOOK
  SLACK
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String?
  workspaceId String?
  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  createdAt DateTime @default(now())
  magicLinks MagicLink[]
}
model Workspace {
  id String @id @default(cuid())
  name String
  logoUrl String?
  websiteUrl String?
  slug String @unique
  createdAt DateTime @default(now())
  users User[]
  captures Capture[]
  proofs Proof[]
  tags Tag[]
  integrations Integration[]
}
model MagicLink {
  id String @id @default(cuid())
  token String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
}
model Capture {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type CaptureType
  name String
  slug String @unique
  status CaptureStatus @default(DRAFT)
  themeId String @default("paper")
  fontId String @default("modern")
  showLogo Boolean @default(true)
  introHeadline String
  introBody String
  thankYouMessage String
  createdAt DateTime @default(now())
  questions Question[]
  submissions Submission[]
}
model Question {
  id String @id @default(cuid())
  captureId String
  capture Capture @relation(fields: [captureId], references: [id], onDelete: Cascade)
  order Int
  type QuestionType
  label String
  helpText String?
  required Boolean @default(true)
  options Json?
  source QuestionSource @default(STATIC)
  parentQuestionId String?
  parentQuestion Question? @relation("Followups", fields: [parentQuestionId], references: [id])
  followups Question[] @relation("Followups")
  answers Answer[]
}
model Submission {
  id String @id @default(cuid())
  captureId String
  capture Capture @relation(fields: [captureId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  respondentName String?
  respondentEmail String?
  respondentCompany String?
  respondentTitle String?
  permission Permission?
  status SubmissionStatus @default(COMPLETE)
  answers Answer[]
  proof Proof?
}
model Answer {
  id String @id @default(cuid())
  submissionId String
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId String
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value Json
  createdAt DateTime @default(now())
}
model Proof {
  id String @id @default(cuid())
  submissionId String @unique
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  quote String
  impactMetric String?
  product String?
  useCase String?
  permission Permission @default(ASK_FIRST)
  archived Boolean @default(false)
  createdAt DateTime @default(now())
  editedAt DateTime @updatedAt
  tags ProofTag[]
}
model Tag {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name String
  proofs ProofTag[]
  @@unique([workspaceId, name])
}
model ProofTag {
  proofId String
  tagId String
  proof Proof @relation(fields: [proofId], references: [id], onDelete: Cascade)
  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([proofId, tagId])
}
model Integration {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type IntegrationType
  config Json
  enabled Boolean @default(true)
  @@unique([workspaceId, type])
}
